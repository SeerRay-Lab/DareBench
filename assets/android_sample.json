{
  "task_id": "android_001",
  "intent": "Open the Settings app, navigate to Wi-Fi settings, and connect to the network named 'TestNetwork'",
  "app_package": "com.android.settings",
  "category": "system_settings",
  "setup": {
    "emulator": "Pixel_6_API_33",
    "pre_conditions": [
      "wifi_disconnected",
      "network_TestNetwork_available"
    ]
  },
  "eval": {
    "eval_type": "state_check",
    "expected_state": {
      "wifi_connected": true,
      "connected_network": "TestNetwork"
    }
  },
  "steps_hint": [
    "Open Settings",
    "Tap Network & Internet",
    "Tap Wi-Fi",
    "Select TestNetwork",
    "Enter password if needed"
  ]
}
