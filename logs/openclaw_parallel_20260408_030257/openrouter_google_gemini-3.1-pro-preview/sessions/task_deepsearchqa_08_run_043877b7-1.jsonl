arch\\n---\\nTesla posts underwhelming financial results for Q4 2023 - Ars Technica\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"4098871a9f19a51d\\\">>>\",\n      \"url\": \"https://arstechnica.com/cars/2024/01/tesla-publishes-its-financial-results-for-2023-profit-margin-shrinks/\",\n      \"description\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"fdfc15f74a8777a3\\\">>>\\nSource: Web Search\\n---\\nFree cash flow increased by 33 percent for the quarter, but its operating margin is almost half that of Q4 2022 at 8.2 percent. For the entirety of 2023, total revenues stood at <strong>$96.8 billion</strong>, of which $82.4 billion came from automotive revenues, ...\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"fdfc15f74a8777a3\\\">>>\",\n      \"published\": \"January 25, 2024\",\n      \"siteName\": \"arstechnica.com\"\n    }\n  ]\n}"}], "details": {"query": "Tesla Q4 2023 financial results total revenues net income 10-K", "provider": "brave", "count": 5, "tookMs": 895, "externalContent": {"untrusted": true, "source": "web_search", "provider": "brave", "wrapped": true}, "results": [{"title": "\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\"7c0886880e25952c\">>>\nSource: Web Search\n---\nTesla, Inc. (TSLA) Income Statement - Yahoo Finance\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\"7c0886880e25952c\">>>", "url": "https://finance.yahoo.com/quote/TSLA/financials/", "description": "\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\"6fdce67a32edaca9\">>>\nSource: Web Search\n---\nGet the detailed quarterly/annual income statement for Tesla, Inc. (TSLA). Find out the revenue, expenses and profit or loss over the last fiscal year.\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\"6fdce67a32edaca9\">>>", "published": "5 days ago", "siteName": "finance.yahoo.com"}, {"title": "\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\"894e3674b7b31573\">>>\nSource: Web Search\n---\nTesla Releases Fourth Quarter and Full Year 2023 Financial Results | Tesla Investor Relations\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\"894e3674b7b31573\">>>", "url"