 Washington, D.C.\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"a5ffed69b32db1eb\\\">>>\",\n      \"siteName\": \"ballotpedia.org\"\n    },\n    {\n      \"title\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"8e06f17ca003beca\\\">>>\\nSource: Web Search\\n---\\nNAEP State and District Snapshots\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"8e06f17ca003beca\\\">>>\",\n      \"url\": \"https://nces.ed.gov/nationsreportcard/snapshots/\",\n      \"description\": \"\\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\\\"6e4ea19d56a32afd\\\">>>\\nSource: Web Search\\n---\\nExplore and download state and district snapshots of NAEP data in mathematics, reading, science, and writing.\\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\\\"6e4ea19d56a32afd\\\">>>\",\n      \"siteName\": \"nces.ed.gov\"\n    }\n  ]\n}"}], "details": {"query": "2022 NAEP grade 8 math scores all states list table Massachusetts 289 Minnesota 285 284 283", "provider": "brave", "count": 10, "tookMs": 1017, "externalContent": {"untrusted": true, "source": "web_search", "provider": "brave", "wrapped": true}, "results": [{"title": "\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\"733f57459bd6eaec\">>>\nSource: Web Search\n---\nNAEP Mathematics: State Average Scores\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\"733f57459bd6eaec\">>>", "url": "https://www.nationsreportcard.gov/mathematics/states/scores/?grade=8", "description": "\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\"8d142b2ca7e1c284\">>>\nSource: Web Search\n---\nThe table below shows the number of states/jurisdictions with score increases or decreases in 2022 and how many states/jurisdictions scored higher, lower, or not significantly different than the nation (public) in NAEP mathematics.\n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\"8d142b2ca7e1c284\">>>", "siteName": "www.nationsreportcard.gov"}, {"title": "\n<<<EXTERNAL_UNTRUSTED_CONTENT id=\"3999f578858bfc87\">>>\nSource: Web Search\n---\n2022 NAEP Mathematics Assessment: Highlighted Results at Grades 4 and 8 for the Nation, States, and Districts | IES\n<<<E